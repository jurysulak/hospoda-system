datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// STOLY A PROSTOR
// -------------------------------------------------------------

model Table {
  id           Int      @id @default(autoincrement())
  name         String
  section      String   @default("Vnitřek")
  status       String   @default("open") // "open", "occupied", "reserved"

  // Údaje o rezervaci
  reservedName String?
  reservedTime String?  // např. "18:30"
  reservedPax  Int?     // počet osob (např. 4)

  posX         Int      @default(0)
  posY         Int      @default(0)
  width        Int      @default(110)
  height       Int      @default(80)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime? // Smazaný stůl s historií plateb se jen skryje (tržby musí zůstat)

  orders       Order[]
}

// -------------------------------------------------------------
// JÍDELNÍ & NÁPOJOVÝ LÍSTEK
// -------------------------------------------------------------

model Product {
  id          Int             @id @default(autoincrement())
  name        String
  category    String
  price       Int
  vatRate     Int             @default(21)
  order       Int             @default(0)   // <-- PŘIDAT TENTO ŘÁDEK (pořadí řazení)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  orderItems  OrderItem[]
  recipeItems ProductRecipe[]
}

// -------------------------------------------------------------
// ÚČTY A OBJEDNÁVKY
// -------------------------------------------------------------

model Order {
  id             Int             @id @default(autoincrement())
  tableId        Int
  status         String          @default("open") // "open", "closed", "cancelled" (zaplaceno a pak stornováno)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  closedAt       DateTime?

  table          Table           @relation(fields: [tableId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  stockMovements StockMovement[] // Audit odpisů pro tento účet
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int?
  productName String   // Historická záloha názvu v momentě prodeje
  unitPrice   Int      // Historická záloha jednotkové ceny
  quantity    Int
  status      String   @default("PENDING") // "PENDING" (vaří se) | "DONE" (vydáno)
  note        String?  // např. "bez cibule", "s sebou", "propečený"
  payerName   String?  // Užitečné pro rozpočítání účtu mezi hosty
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Payment {
  id            Int      @id @default(autoincrement())
  orderId       Int
  payerName     String?
  amount        Int
  paymentMethod String? // "cash", "card", "voucher"
  receiptNumber String? // <-- Přidej tento řádek
  cancelledAt   DateTime? // Kdy byla platba stornována (null = platná). Stornované se nezapočítávají do tržeb.
  createdAt     DateTime @default(now())

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eetRecords EetRecord[]
}

// Evidence tržeb EET 2.0 – jeden záznam = jedna evidovaná tržba (platba nebo její storno se zápornou částkou).
// Pořadové číslo tržby (porad_cis) = id záznamu.
model EetRecord {
  id            Int       @id @default(autoincrement())
  paymentId     Int?      // null po smazání stolu – záznam o evidované tržbě musí zůstat
  kind          String    // "SALE" | "STORNO"
  amount        Int       // Kč, u storna záporně
  datTrzby      DateTime  // okamžik uskutečnění tržby
  status        String    @default("PENDING") // "PENDING" | "SENT" | "ERROR"
  pok           String?   // potvrzovací kód z EET
  test          Boolean   @default(false) // odesláno do testovacího prostředí (playground)
  attempts      Int       @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([status])
}

// -------------------------------------------------------------
// SKLADOVÉ HOSPODÁŘSTVÍ
// -------------------------------------------------------------

model StockItem {
  id          Int             @id @default(autoincrement())
  name        String          // např. "Radegast 12 sud", "Kofola sirup"
  unit        String          @default("ks") // "ks", "l", "kg"
  quantity    Float           @default(0)
  minQuantity Float           @default(0)    // Upozornění na docházející zásoby
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  movements   StockMovement[]
  recipes     ProductRecipe[]
}

model ProductRecipe {
  id          Int       @id @default(autoincrement())
  productId   Int
  stockItemId Int
  amount      Float     // Množství suroviny na 1 prodejní jednotku

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([productId, stockItemId])
}

model StockMovement {
  id          Int       @id @default(autoincrement())
  stockItemId Int
  orderId     Int?      // Volitelná vazba na účet při automatickém odpisu
  type        String    // "sale", "restock", "waste"
  quantity    Float
  note        String?
  createdAt   DateTime  @default(now())

  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
}